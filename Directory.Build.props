<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <COI_ROOT Condition="'$(COI_ROOT)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Captain of Industry</COI_ROOT>
    <GameManaged>$(COI_ROOT)\Captain of Industry_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Mafi"><HintPath>$(GameManaged)\Mafi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mafi.Core"><HintPath>$(GameManaged)\Mafi.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mafi.Base"><HintPath>$(GameManaged)\Mafi.Base.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameInstallation" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)\Mafi.Core.dll')" Text="Game assemblies not found. Set COI_ROOT to your Captain of Industry installation directory." />
  </Target>
</Project>
